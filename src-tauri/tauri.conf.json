{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "1.0.0",
  "identifier": "ba.lunatik.pazar",
  "build": {
    "beforeDevCommand": "bun run tauri:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run tauri:vite:build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Pazar kasa",
    "longDescription": "Pazar POS application for Bosnian market",
    "copyright": "© 2026 Tarik Caplja / Lunatik",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
